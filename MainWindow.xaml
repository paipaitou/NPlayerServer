<Window x:Class="NPlayerServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="nPlayer 视频服务"
        Width="640" Height="840" MinWidth="600" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F4"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Foreground="#2C2C2A"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="StatusCard" Grid.Row="0" Style="{StaticResource Card}"
                Background="#F4F4F1" BorderBrush="#E8E6DF" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="#B4B2A9"
                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="服务已停止" FontSize="13" FontWeight="Medium"
                               Foreground="#5F5E5A"/>
                    <TextBlock x:Name="StatusSub" Text="点击右侧按钮启动" FontSize="11"
                               Foreground="#888780" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="ToggleButton" Grid.Column="2" Content="启动服务" Width="112"
                        Style="{StaticResource PrimaryButton}" Click="ToggleServer_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="连接设置" Style="{StaticResource CardTitle}"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="协议" Style="{StaticResource FieldLabel}"/>
                    <CheckBox x:Name="WebDavCheck" Content="WebDAV" IsChecked="True"
                              Checked="Protocol_Changed" Unchecked="Protocol_Changed" Margin="0,0,18,0"/>
                    <CheckBox x:Name="FtpCheck" Content="FTP"
                              Checked="Protocol_Changed" Unchecked="Protocol_Changed"/>
                    <TextBlock Text="可同时开启，nPlayer 里任选其一连接" Style="{StaticResource Hint}"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="WebDAV 端口" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PortBox" Width="78" Text="8000" MaxLength="5"
                             LostFocus="PortBox_LostFocus"/>
                    <TextBlock Text="FTP 端口" Style="{StaticResource FieldLabel}" Margin="20,0,8,0"/>
                    <TextBox x:Name="FtpPortBox" Width="70" Text="21" MaxLength="5"
                             LostFocus="PortBox_LostFocus"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="监听地址" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="BindBox" Width="150" IsEditable="True"
                              SelectionChanged="BindBox_SelectionChanged"
                              LostFocus="BindBox_LostFocus"/>
                    <TextBlock Text="0.0.0.0 表示全部网卡" Style="{StaticResource Hint}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.RowSpan="2" Text="访问地址" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Top" Margin="0,6,8,0"/>

                    <TextBlock Grid.Column="1" x:Name="HttpUrlText" Text="—" FontSize="12"
                               Foreground="#185FA5" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" x:Name="FtpUrlText" Text="—" FontSize="12"
                               Foreground="#185FA5" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,6,0,0"/>

                    <Button Grid.Column="2" Content="复制" Style="{StaticResource SecondaryButton}"
                            Height="22" Padding="10,0" Click="CopyHttpUrl_Click"/>
                    <Button Grid.Column="2" Grid.Row="1" Content="复制" Style="{StaticResource SecondaryButton}"
                            Height="22" Padding="10,0" Click="CopyFtpUrl_Click" Margin="8,6,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="共享目录" Style="{StaticResource CardTitle}" Margin="0"/>
                    <Button Content="+ 添加目录" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}"
                            Height="24" Padding="10,0" Click="AddShare_Click"/>
                </Grid>
                <ListBox x:Name="ShareList" MaxHeight="150" ItemContainerStyle="{StaticResource ShareRow}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FAFAF8" BorderBrush="#E8E6DF" BorderThickness="1"
                                    CornerRadius="6" Padding="10,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Path}" FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}"
                                             Height="24" FontSize="11" Padding="6,0"/>
                                    <Button Grid.Column="2" Content="&#x2715;" Style="{StaticResource IconButton}"
                                            Click="RemoveShare_Click" Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                           Text="右侧文本框是该目录在 nPlayer 里的访问路径，各目录不能重复"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="认证" Style="{StaticResource CardTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="用户名" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UserBox" Grid.Column="1" Text="user" LostFocus="Auth_LostFocus"/>
                    <TextBlock Grid.Column="2" Text="密码" Style="{StaticResource FieldLabel}"
                               Margin="16,0,8,0"/>
                    <TextBox x:Name="PassBox" Grid.Column="3" Text="" LostFocus="Auth_LostFocus"/>
                    <Border Grid.Column="4" x:Name="AnonBadge" Background="#FAEEDA" CornerRadius="4"
                            Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="无认证" FontSize="11" Foreground="#854F0B"/>
                    </Border>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="密码留空时任何人不经认证即可访问，仅建议在家庭内网使用"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="运行日志" Style="{StaticResource CardTitle}" Margin="0"/>
                    <Button Content="清空" HorizontalAlignment="Right" Style="{StaticResource LinkButton}"
                            Click="ClearLog_Click"/>
                </Grid>
                <ListBox x:Name="LogList" Grid.Row="1" FontFamily="Consolas, Microsoft YaHei UI"
                         FontSize="11" Foreground="#5F5E5A">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Margin="0,1"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="4,0,4,0">
            <TextBlock x:Name="StatLeft" Text="当前连接 0  ·  已传输 0 B" FontSize="11" Foreground="#888780"/>
            <TextBlock Text="关闭窗口后驻留系统托盘" FontSize="11" Foreground="#888780"
                       HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
